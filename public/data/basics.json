    {
      "id": "bs-greet",
      "level": 1,
      "title": "Chào hỏi và giới thiệu bản thân",
      "intro": "Ngày đầu gặp khách hoặc đồng nghiệp Hàn: chào, nói tên, nói mình làm gì.",
      "words": [
        { "ko": "안녕하세요", "vi": "xin chào" },
        { "ko": "이름", "vi": "tên" },
        { "ko": "베트남 사람", "vi": "người Việt Nam" },
        { "ko": "개발자", "vi": "lập trình viên" },
        { "ko": "반갑습니다", "vi": "rất vui được gặp" }
      ],
      "lines": [
        { "ko": "안녕하세요.", "pron": "[안녕하세요]", "vi": "Xin chào." },
        { "ko": "처음 뵙겠습니다.", "pron": "[처음 뵙껟씀니다]", "vi": "Lần đầu được gặp anh/chị.", "note": "Câu chào rất lịch sự khi gặp lần đầu, hợp với khách hàng." },
        { "ko": "제 이름은 안이에요.", "pron": "[제 이르믄 아니에요]", "vi": "Tên tôi là An.", "note": "Thay 안 bằng tên của bạn. 이름은 → [이르믄]: patchim ㅁ nối sang nguyên âm sau." },
        { "ko": "저는 베트남 사람이에요.", "pron": "[저는 베트남 사라미에요]", "vi": "Tôi là người Việt Nam." },
        { "ko": "저는 개발자예요.", "pron": "[저는 개발자에요]", "vi": "Tôi là lập trình viên.", "note": "Sau từ không có patchim dùng -예요, có patchim dùng -이에요 (사람이에요)." },
        { "ko": "만나서 반갑습니다.", "pron": "[만나서 반갑씀니다]", "vi": "Rất vui được gặp anh/chị." },
        { "ko": "잘 부탁드립니다.", "pron": "[잘 부탁뜨림니다]", "vi": "Mong anh/chị giúp đỡ.", "note": "Câu kết lời giới thiệu, gần như luôn được nói." }
      ]
    },
    {
      "id": "bs-company",
      "level": 1,
      "title": "Công ty và nhóm của tôi",
      "intro": "Nói công ty ở đâu, nhóm có mấy người, mình làm dự án gì.",
      "words": [
        { "ko": "회사", "vi": "công ty" },
        { "ko": "팀", "vi": "nhóm, team" },
        { "ko": "팀장님", "vi": "trưởng nhóm" },
        { "ko": "프로젝트", "vi": "dự án" },
        { "ko": "일하다", "vi": "làm việc" },
        { "ko": "어디", "vi": "ở đâu" }
      ],
      "lines": [
        { "ko": "저는 IT 회사에서 일해요.", "pron": "[저는 아이티 회사에서 일해요]", "vi": "Tôi làm việc ở một công ty IT.", "note": "N에서 + động từ: làm gì ở đâu." },
        { "ko": "회사는 하노이에 있어요.", "pron": "[회사는 하노이에 이써요]", "vi": "Công ty ở Hà Nội.", "note": "N에 있어요: ở đâu đó. 있어요 → [이써요]." },
        { "ko": "회사가 어디에 있어요?", "pron": "[회사가 어디에 이써요]", "vi": "Công ty ở đâu?" },
        { "ko": "우리 팀은 다섯 명이에요.", "pron": "[우리 티믄 다섣 명이에요]", "vi": "Nhóm chúng tôi có năm người.", "note": "Đếm người dùng số thuần Hàn + 명: 한 명, 두 명, 세 명…" },
        { "ko": "팀장님은 한국 사람이에요.", "pron": "[팀장니믄 한국 사라미에요]", "vi": "Trưởng nhóm là người Hàn Quốc." },
        { "ko": "한국 프로젝트를 해요.", "pron": "[한국 프로젝트를 해요]", "vi": "Tôi làm dự án của Hàn Quốc." }
      ]
    },
    {
      "id": "bs-time",
      "level": 1,
      "title": "Giờ và ngày",
      "intro": "Hỏi giờ, nói giờ họp, giờ đi làm và tan làm.",
      "words": [
        { "ko": "시", "vi": "giờ" },
        { "ko": "분", "vi": "phút" },
        { "ko": "오늘", "vi": "hôm nay" },
        { "ko": "내일", "vi": "ngày mai" },
        { "ko": "출근하다", "vi": "đi làm" },
        { "ko": "퇴근하다", "vi": "tan làm" }
      ],
      "lines": [
        { "ko": "지금 몇 시예요?", "pron": "[지금 멷 씨에요]", "vi": "Bây giờ là mấy giờ?", "note": "몇 시 → [멷 씨]: sau patchim ㄷ, ㅅ đọc căng thành ㅆ." },
        { "ko": "아홉 시에 출근해요.", "pron": "[아홉 씨에 출근해요]", "vi": "Tôi đi làm lúc chín giờ.", "note": "Giờ dùng số thuần Hàn (한 시, 두 시, 아홉 시), phút dùng số Hán Hàn (삼십 분)." },
        { "ko": "회의는 두 시예요.", "pron": "[회의는 두 시에요]", "vi": "Cuộc họp lúc hai giờ." },
        { "ko": "오늘은 월요일이에요.", "pron": "[오느른 워료이리에요]", "vi": "Hôm nay là thứ Hai." },
        { "ko": "내일 세 시 삼십 분에 만나요.", "pron": "[내일 세 시 삼십 뿌네 만나요]", "vi": "Mai gặp nhau lúc ba giờ ba mươi." },
        { "ko": "여섯 시에 퇴근해요.", "pron": "[여섣 씨에 퇴근해요]", "vi": "Sáu giờ tôi tan làm." }
      ]
    },
    {
      "id": "bs-office",
      "level": 1,
      "title": "Trong văn phòng: có / không có",
      "intro": "Hỏi phòng họp ở đâu, có màn hình không, mật khẩu wifi là gì.",
      "words": [
