        { "ko": "회의실은 삼 층에 있어요.", "pron": "[회의시른 삼 층에 이써요]", "vi": "Phòng họp ở tầng ba.", "note": "Tầng dùng số Hán Hàn: 일 층, 이 층, 삼 층." },
        { "ko": "모니터가 하나 더 있어요?", "pron": "[모니터가 하나 더 이써요]", "vi": "Có thêm một màn hình nữa không?" },
        { "ko": "지금 빈 회의실이 없어요.", "pron": "[지금 빈 회의시리 업써요]", "vi": "Bây giờ không còn phòng họp trống.", "note": "없어요 → [업써요]: patchim ㅄ, ㅅ đọc sang âm sau thành ㅆ." },
        { "ko": "제 노트북이 여기 있어요.", "pron": "[제 노트부기 여기 이써요]", "vi": "Laptop của tôi ở đây." },
        { "ko": "와이파이 비밀번호가 뭐예요?", "pron": "[와이파이 비밀번호가 뭐에요]", "vi": "Mật khẩu wifi là gì?" }
      ]
    },
