    {
      "id": "hg-vowels-1",
      "title": "Nguyên âm cơ bản (1)",
      "intro": "Sáu nguyên âm đầu tiên và cách ghép một âm tiết. Bắt đầu từ đây nếu bạn chưa đọc được chữ Hàn.",
      "tips": [
        "Chữ Hàn viết theo khối: mỗi khối là một âm tiết, gồm phụ âm đầu + nguyên âm (+ phụ âm cuối).",
        "Âm tiết không có phụ âm đầu thì viết ㅇ ở chỗ đó. ㅇ đứng đầu không đọc: 아 đọc là [a].",
        "Nguyên âm dọc (ㅏ ㅓ ㅣ) đứng bên phải ㅇ, nguyên âm ngang (ㅗ ㅜ ㅡ) đứng bên dưới: 아, 오."
      ],
      "letters": [
        { "char": "ㅏ", "sound": "a", "syllable": "아", "confuse": ["어"] },
        { "char": "ㅓ", "sound": "ơ, miệng mở rộng (gần 'o' trong 'to')", "syllable": "어", "confuse": ["오", "아"], "note": "Không tròn môi. Khác ㅗ là phải tròn môi." },
        { "char": "ㅗ", "sound": "ô, tròn môi", "syllable": "오", "confuse": ["어", "우"] },
        { "char": "ㅜ", "sound": "u", "syllable": "우", "confuse": ["오", "으"] },
        { "char": "ㅡ", "sound": "ư", "syllable": "으", "confuse": ["우"], "note": "Môi kéo ngang, không tròn." },
        { "char": "ㅣ", "sound": "i", "syllable": "이", "confuse": ["으"] }
      ],
      "words": [
        { "ko": "아이", "vi": "đứa trẻ" },
        { "ko": "오이", "vi": "dưa chuột" },
        { "ko": "이", "vi": "số hai; cái răng" },
        { "ko": "오", "vi": "số năm" },
        { "ko": "우아", "vi": "thanh lịch (trong 우아하다)" }
      ]
