# Optional backend (Phase 2). Leave unset for the static app (default).
# The learner can also set or change it on the Settings page (/settings),
# which overrides this build-time default on that device.
# VITE_API_BASE_URL=https://korean-practice-backend.onrender.com

# Where production builds load the natural-voice MP3s from (no trailing slash).
# Unset = GitHub Pages (https://nhat111.github.io/korean-practice, see
# .github/workflows/audio-pages.yml). Empty = this origin (dist/audio is kept).
# VITE_AUDIO_BASE_URL=

# Public contact address shown on the About page (/about). Unset = no email shown.
# VITE_CONTACT_EMAIL=

# Public address of the production site, no trailing slash. Used in the Open
# Graph tags, the calendar reminder link and the share image. Unset =
# https://kodevtalk.vercel.app. Set it on Vercel once the custom domain is live;
# the old address then shows a banner pointing learners to the new one.
# VITE_SITE_URL=https://kodevtalk.example.com
